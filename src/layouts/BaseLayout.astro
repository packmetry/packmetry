---
interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Packmetry',
  description =
    'A browser-first packing and cartonization workbench for finding practical, verified packing plans.',
  ogType = 'website',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalPath =
  pathname === '/'
    ? '/'
    : `${pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = new URL(
  canonicalPath,
  Astro.site ?? 'https://packmetry.com'
);

const siteUrl =
  new URL(
    '/',
    Astro.site ?? 'https://packmetry.com'
  ).href;

const isHomePage = pathname === '/';

const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Packmetry',
      url: siteUrl,
      email: 'packmetry@gmail.com',
      description:
        'A browser-first packing and cartonization decision workbench.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Packmetry',
      description:
        'Practical, verified packing decisions for personal shipments and business carton workflows.',
      publisher: {
        '@id': `${siteUrl}#organization`,
      },
      inLanguage: 'en',
    },
  ],
};

const homeStructuredDataJson =
  JSON.stringify(homeStructuredData).replace(
    /</g,
    '\\u003c'
  );

function isCurrent(path: string) {
  if (path === '/') {
    return pathname === '/';
  }

  return (
    pathname === path ||
    pathname.startsWith(path)
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <meta
      property="og:site_name"
      content="Packmetry"
    />

    <meta
      property="og:type"
      content={ogType}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0f5a48"
    />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />

    <link
      rel="sitemap"
      href="/sitemap.xml"
    />

    <title>{title}</title>

    {
      isHomePage && (
        <script
          type="application/ld+json"
          set:html={homeStructuredDataJson}
        ></script>
      )
    }
  </head>

  <body>
    <a
      class="pm-skip-link"
      href="#main-content"
    >
      Skip to content
    </a>

    <header class="pm-site-header">
      <div class="pm-site-header-inner">
        <a
          class="pm-site-brand"
          href="/"
          aria-label="Packmetry home"
        >
          <svg
            class="pm-site-mark"
            viewBox="0 0 64 64"
            aria-hidden="true"
          >
            <path
              class="pm-mark-outline"
              d="M50.8 18.6 32 7.8 13.2 18.6v27.1L32 56.2"
              fill="none"
              stroke="#0f5a48"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="4.2"
            />

            <path
              class="pm-mark-outline pm-mark-outline-short"
              d="M13.2 18.6 31.9 29.4"
              fill="none"
              stroke="#0f5a48"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3.8"
            />

            <path
              class="pm-mark-top"
              d="M23 23.9 36.6 16l13.7 7.9-13.7 8Z"
              fill="#cfeadf"
            />

            <path
              class="pm-mark-left-face"
              d="M23 23.9 36.6 31.9v16.2L23 40.2Z"
              fill="#58b796"
            />

            <path
              class="pm-mark-right-face"
              d="M36.6 31.9 50.3 23.9v16.3l-13.7 7.9Z"
              fill="#2f8d72"
            />
          </svg>

          <span>Packmetry</span>
        </a>

        <nav
          class="pm-site-nav"
          aria-label="Primary navigation"
        >
          <a
            href="/"
            aria-current={
              isCurrent('/')
                ? 'page'
                : undefined
            }
          >
            Home
          </a>

          <a
            href="/personal/"
            aria-current={
              isCurrent('/personal/')
                ? 'page'
                : undefined
            }
          >
            Personal
          </a>

          <a
            href="/business/"
            aria-current={
              isCurrent('/business/')
                ? 'page'
                : undefined
            }
          >
            Business
          </a>

          <a
            href="/guides/"
            aria-current={
              isCurrent('/guides/')
                ? 'page'
                : undefined
            }
          >
            Guides
          </a>
        </nav>
      </div>
    </header>

    <div id="main-content">
      <slot />
    </div>

    <footer class="pm-site-footer">
      <div class="pm-site-footer-inner">
        <div>
          <strong>Packmetry</strong>

          <span>
            Packing decisions, in your browser.
          </span>
        </div>

        <nav
          class="pm-site-footer-nav"
          aria-label="Footer navigation"
        >
          <a href="/personal/">
            Personal
          </a>

          <a href="/business/">
            Business
          </a>

          <a href="/tools/">
            Tools
          </a>

          <a href="/guides/">
            Guides
          </a>

          <a href="/contact/">
            Contact
          </a>

          <a href="/privacy/">
            Privacy
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .pm-skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 200;
    padding: 8px 12px;
    border-radius: 6px;
    background: #17212b;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-160%);
  }

  .pm-skip-link:focus {
    transform: translateY(0);
  }

  .pm-site-header {
    position: relative;
    z-index: 20;
    width: 100%;
    border-bottom: 1px solid #e3e7e8;
    background: #fbfcfb;
  }

  .pm-site-header-inner {
    display: flex;
    width: min(
      calc(100% - 40px),
      1240px
    );
    min-height: 66px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .pm-site-brand {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    color: #17212b;
    font-family:
      "Segoe UI",
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .pm-site-mark {
    width: 42px;
    height: 42px;
    flex: none;
    overflow: visible;
    filter:
      drop-shadow(
        0 4px 7px
        rgba(15, 90, 72, 0.07)
      );
  }

  .pm-site-mark .pm-mark-outline {
    fill: none;
    stroke: #0f5a48;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 4.2;
  }

  .pm-site-mark .pm-mark-outline-short {
    stroke-width: 3.8;
  }

  .pm-site-mark .pm-mark-top {
    fill: #cfeadf;
  }

  .pm-site-mark .pm-mark-left-face {
    fill: #58b796;
  }

  .pm-site-mark .pm-mark-right-face {
    fill: #2f8d72;
  }

  .pm-site-nav {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .pm-site-nav a {
    position: relative;
    min-height: 36px;
    padding: 8px 11px;
    border-radius: 6px;
    color: #667075;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 20px;
    text-decoration: none;
    transition:
      color 120ms ease,
      background 120ms ease;
  }

  .pm-site-nav a:hover {
    background: #f1f3f2;
    color: #17212b;
  }

  .pm-site-nav a[aria-current="page"] {
    color: #17212b;
  }

  .pm-site-nav a[aria-current="page"]::after {
    position: absolute;
    right: 11px;
    bottom: 3px;
    left: 11px;
    height: 1px;
    background: #2e5d50;
    content: "";
  }

  .pm-site-footer {
    width: 100%;
    border-top: 1px solid #e3e7e8;
    background: #fbfcfb;
  }

  .pm-site-footer-inner {
    display: flex;
    width: min(
      calc(100% - 40px),
      1240px
    );
    min-height: 86px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #667075;
    font-size: 0.76rem;
  }

  .pm-site-footer-inner > div {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .pm-site-footer strong {
    color: #17212b;
    font-size: 0.8rem;
  }

  .pm-site-footer-nav {
    display: flex;
    gap: 18px;
  }

  .pm-site-footer-nav a {
    color: #667075;
    font-weight: 600;
    text-decoration: none;
  }

  .pm-site-footer-nav a:hover {
    color: #17212b;
  }

  @media (max-width: 639px) {
    .pm-site-header-inner {
      width: calc(100% - 32px);
      min-height: 60px;
      gap: 14px;
    }

    .pm-site-mark {
      width: 36px;
      height: 36px;
    }

    .pm-site-brand {
      gap: 8px;
      font-size: 0.96rem;
    }

    .pm-site-brand span {
      display: none;
    }

    .pm-site-nav {
      gap: 0;
    }

    .pm-site-nav a {
      min-height: 38px;
      padding-right: 7px;
      padding-left: 7px;
      font-size: 0.74rem;
    }

    .pm-site-nav a[aria-current="page"]::after {
      right: 7px;
      left: 7px;
    }

    .pm-site-footer-inner {
      width: calc(100% - 32px);
      min-height: 0;
      padding: 24px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 13px;
    }

    .pm-site-footer-inner > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }

    /*
     * Mobile workspace polish.
     * Keep desktop route design untouched while making
     * 360–639px screens substantially less tall.
     */

    .pm-personal-page :where(.pm-workbench),
    .pm-business-page :where(.pm-workbench) {
      gap: 16px !important;
      padding-top: 16px !important;
    }

    .pm-personal-page :where(.pm-setup-pane),
    .pm-personal-page :where(.pm-result-pane),
    .pm-business-page :where(.pm-setup-pane),
    .pm-business-page :where(.pm-result-pane) {
      padding: 16px !important;
    }

    .pm-personal-page :where(.pm-form-section),
    .pm-business-page :where(.pm-form-section) {
      padding-top: 15px !important;
      padding-bottom: 15px !important;
    }

    .pm-personal-page :where(.pm-summary-status),
    .pm-business-page :where(.pm-summary-status) {
      width: fit-content;
      justify-self: start;
    }

    .pm-personal-page :where(.pm-empty-result),
    .pm-business-page :where(.pm-empty-result) {
      min-height: 300px !important;
    }

    .pm-personal-page :where(.pm-result-pane),
    .pm-business-page :where(.pm-result-pane) {
      min-height: 340px !important;
    }

    .pm-personal-page :where(.pm-add-button),
    .pm-business-page :where(.pm-add-button) {
      min-height: 36px !important;
    }

    .pm-personal-page :where(.pm-number-input),
    .pm-business-page :where(.pm-number-input) {
      height: 40px !important;
    }
  }

  @media (min-width: 360px) and (max-width: 639px) {
    /*
     * Personal: keep the compact desktop relationships
     * instead of turning every control into a full row.
     */

    .pm-personal-page :where(.pm-mode-selector) {
      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        ) !important;
    }

    .pm-personal-page :where(.pm-mode-option) {
      min-height: 44px !important;
      padding: 6px 5px !important;
      font-size: 0.69rem !important;
      text-align: center !important;
    }

    .pm-personal-page
      :where(
        .pm-measurement-grid,
        .pm-carton-fields
      ) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        ) !important;
    }

    .pm-personal-page
      :where(
        .pm-measurement-grid
        .pm-field:last-child
      ) {
      grid-column: auto !important;
    }

    .pm-personal-page :where(.pm-field-label) {
      font-size: 0.69rem !important;
    }

    /*
     * Business: two-column data entry cuts a large amount
     * of scrolling while preserving readable touch targets.
     */

    .pm-business-page
      :where(
        .pm-carton-fields,
        .pm-measurement-grid
      ) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        ) !important;
    }

    .pm-business-page :where(.pm-mode-selector) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        ) !important;
    }

    .pm-business-page
      :where(
        .pm-mode-selector[
          aria-label^="Handling"
        ]
      ) {
      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        ) !important;
    }

    .pm-business-page :where(.pm-mode-option) {
      min-height: 43px !important;
      padding: 6px 5px !important;
      font-size: 0.68rem !important;
      text-align: center !important;
    }

    .pm-business-page :where(.pm-field-label) {
      font-size: 0.68rem !important;
    }

    .pm-business-page
      :where(
        .pm-business-disclosure-summary
      ) {
      min-height: 54px !important;
    }

    .pm-business-page
      :where(
        .pm-business-disclosure-summary strong
      ) {
      font-size: 0.88rem !important;
    }

    .pm-business-page
      :where(
        .pm-business-disclosure-summary small
      ) {
      font-size: 0.68rem !important;
    }
  }

  @media (max-width: 359px) {
    .pm-site-header-inner {
      width: calc(100% - 24px);
    }

    .pm-site-brand {
      gap: 0;
      font-size: 0.88rem;
    }

    .pm-site-mark {
      width: 32px;
      height: 32px;
    }

    .pm-site-nav a {
      padding-right: 6px;
      padding-left: 6px;
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-site-nav a,
    .pm-skip-link {
      transition: none;
    }
  }
</style>
