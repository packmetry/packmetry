---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/packmetry-workspace.css';

const guides = [
  {
    category: 'Box selection',
    title: 'Choosing a box without wasting space',
    description:
      'A practical way to think about internal dimensions, fit, empty space and why the smallest-looking box is not always the best packing decision.',
    href: '/guides/choosing-a-box/',
    readTime: '6 min read',
  },
  {
    category: 'Existing inventory',
    title: 'Packing with boxes you already have',
    description:
      'How to treat carton stock as a real constraint, what available quantity changes, and when a hybrid packing workflow becomes useful.',
    href: '/guides/packing-with-existing-boxes/',
    readTime: '5 min read',
  },
  {
    category: 'Dimensional weight',
    title: 'DIM weight without the carrier guesswork',
    description:
      'Understand what dimensional weight measures, why external carton dimensions matter, and what Packmetry deliberately does not assume.',
    href: '/guides/dimensional-weight/',
    readTime: '7 min read',
  },
];
---

<BaseLayout
  title="Packmetry Guides — Practical packing knowledge"
  description="Practical guides to box selection, existing-carton packing, dimensional weight and verified packing decisions."
>
  <main class="pm-guides">
    <header class="pm-guides-hero">
      <p class="pm-guides-eyebrow">
        Packmetry Guides
      </p>

      <h1>
        Packing decisions,
        <span>explained clearly.</span>
      </h1>

      <p>
        Notes for people who want to make better
        packing decisions without turning the job
        into a logistics textbook. The library will
        grow alongside Packmetry.
      </p>
    </header>

    <section
      class="pm-guides-library"
      aria-labelledby="guide-library-title"
    >
      <div class="pm-guides-library-heading">
        <p class="pm-guides-eyebrow">
          Guide library
        </p>

        <h2 id="guide-library-title">
          Start with the decision you are making.
        </h2>
      </div>

      <div class="pm-guides-list">
        {
          guides.map((guide, index) => (
            <article class="pm-guide-row">
              <div class="pm-guide-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="pm-guide-row-copy">
                <div class="pm-guide-row-meta">
                  <span>{guide.category}</span>
                  <span aria-hidden="true">·</span>
                  <span>{guide.readTime}</span>
                </div>

                <h3>
                  <a href={guide.href}>
                    {guide.title}
                  </a>
                </h3>

                <p>{guide.description}</p>
              </div>

              <a
                class="pm-guide-row-arrow"
                href={guide.href}
                aria-label={`Read ${guide.title}`}
              >
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="pm-guides-close">
      <div>
        <p class="pm-guides-eyebrow">
          A growing reference
        </p>

        <h2>
          More guides will be published here
          as Packmetry expands.
        </h2>
      </div>

      <p>
        The goal is useful reference material:
        packing geometry, carton inventory,
        dimensional weight, handling constraints
        and practical decision-making — without
        invented carrier rules or sales copy.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .pm-guides {
    width: min(
      calc(100% - 40px),
      1240px
    );
    margin: 0 auto;
    padding: 78px 0 78px;
  }

  .pm-guides-hero {
    max-width: 820px;
    padding-bottom: 72px;
  }

  .pm-guides-eyebrow {
    margin: 0;
    color: var(--pm-forest);
    font-size: 0.71rem;
    font-weight: 740;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pm-guides-hero h1 {
    margin: 18px 0 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      3.2rem,
      6vw,
      5.8rem
    );
    font-weight: 680;
    letter-spacing: -0.062em;
    line-height: 0.94;
  }

  .pm-guides-hero h1 span {
    display: block;
    color: #556165;
    font-weight: 560;
  }

  .pm-guides-hero > p:last-child {
    max-width: 680px;
    margin: 27px 0 0;
    color: var(--pm-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  .pm-guides-library {
    border-top: 1px solid var(--pm-line);
    padding-top: 66px;
  }

  .pm-guides-library-heading {
    display: grid;
    max-width: 760px;
    gap: 12px;
    margin-bottom: 34px;
  }

  .pm-guides-library-heading h2,
  .pm-guides-close h2 {
    margin: 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      1.9rem,
      3.4vw,
      3rem
    );
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .pm-guides-list {
    border-top: 1px solid var(--pm-line-strong);
  }

  .pm-guide-row {
    display: grid;
    grid-template-columns:
      54px
      minmax(0, 1fr)
      auto;
    gap: 28px;
    align-items: center;
    border-bottom: 1px solid var(--pm-line);
    padding: 32px 6px;
    transition:
      background 140ms ease;
  }

  .pm-guide-row:hover {
    background: rgba(
      243,
      247,
      245,
      0.55
    );
  }

  .pm-guide-index {
    color: #9aa3a6;
    font-size: 0.7rem;
    font-weight: 680;
    font-variant-numeric: tabular-nums;
  }

  .pm-guide-row-copy {
    max-width: 850px;
  }

  .pm-guide-row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    color: var(--pm-forest);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.035em;
  }

  .pm-guide-row h3 {
    margin: 9px 0 0;
    font-size: clamp(
      1.45rem,
      2.5vw,
      2.15rem
    );
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .pm-guide-row h3 a {
    color: var(--pm-ink-strong);
    text-decoration: none;
  }

  .pm-guide-row h3 a:hover {
    color: var(--pm-forest);
  }

  .pm-guide-row-copy > p {
    max-width: 780px;
    margin: 12px 0 0;
    color: var(--pm-ink-soft);
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .pm-guide-row-arrow {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--pm-line-strong);
    border-radius: 50%;
    color: var(--pm-navy);
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .pm-guide-row-arrow:hover {
    border-color: #aebfba;
    background: var(--pm-forest-soft);
    transform: translateX(2px);
  }

  .pm-guides-close {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.72fr);
    gap: clamp(
      45px,
      8vw,
      100px
    );
    align-items: end;
    margin-top: 78px;
    border: 1px solid #dbe2df;
    border-radius: 14px;
    padding:
      clamp(30px, 5vw, 56px);
    background:
      linear-gradient(
        135deg,
        #f3f7f5 0%,
        #f7f9f8 100%
      );
  }

  .pm-guides-close h2 {
    margin-top: 12px;
  }

  .pm-guides-close > p {
    margin: 0;
    color: var(--pm-ink-soft);
    font-size: 0.87rem;
    line-height: 1.68;
  }

  @media (max-width: 639px) {
    .pm-guides {
      width: calc(100% - 32px);
      padding: 48px 0 52px;
    }

    .pm-guides-hero {
      padding-bottom: 50px;
    }

    .pm-guides-hero h1 {
      font-size: clamp(
        2.8rem,
        14vw,
        4rem
      );
    }

    .pm-guides-library {
      padding-top: 48px;
    }

    .pm-guide-row {
      grid-template-columns:
        minmax(0, 1fr)
        auto;
      gap: 14px;
      padding: 26px 0;
    }

    .pm-guide-index {
      display: none;
    }

    .pm-guide-row-arrow {
      width: 38px;
      height: 38px;
    }

    .pm-guides-close {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 54px;
      padding: 26px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-guide-row,
    .pm-guide-row-arrow {
      transition: none;
    }
  }
</style>
