---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/packmetry-workspace.css';
import '../../styles/dimensional-weight-tool.css';
import '../../styles/box-size-tool.css';
---

<BaseLayout
  title="Packing Tools — Packmetry"
  description="Practical browser-based tools for dimensional weight, single-item box sizing, carton utilization, identical-item grid capacity and real packing decisions."
>
  <main class="pm-tools-page">
    <div class="pm-tools-shell">
      <header class="pm-tools-hero">
        <p class="pm-tool-kicker">
          Packmetry Tools
        </p>

        <h1>
          Useful tools for
          real packing decisions.
        </h1>

        <p>
          Small calculators belong here only when
          they connect to an actual packing decision
          and use the same unit-safe rules as the
          Packmetry workbench.
        </p>
      </header>

      <section
        class="pm-tools-list"
        aria-labelledby="tools-list-title"
      >
        <article class="pm-tools-card">
          <div>
            <p class="pm-tool-kicker">
              Weight &amp; dimensions
            </p>

            <h2 id="tools-list-title">
              Dimensional weight calculator
            </h2>

            <p>
              Calculate DIM weight from external
              package dimensions and an explicit
              divisor. Add actual gross weight to
              compare the base chargeable-weight
              estimate without assuming carrier
              rates or billing rounding.
            </p>
          </div>

          <a
            href="/tools/dimensional-weight-calculator/"
          >
            Open calculator
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="pm-tools-card">
          <div>
            <p class="pm-tool-kicker">
              Single-item geometry
            </p>

            <h2>
              Box size calculator
            </h2>

            <p>
              Find the minimum internal box profiles
              needed for one rectangular item under
              its allowed rotation policy, or check
              whether an available box fits
              geometrically.
            </p>
          </div>

          <a
            href="/tools/box-size-calculator/"
          >
            Open calculator
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="pm-tools-card">
          <div>
            <p class="pm-tool-kicker">
              Volume comparison
            </p>

            <h2>
              Box utilization calculator
            </h2>

            <p>
              Compare identical item volume with
              usable internal carton volume. See
              requested utilization and remaining
              volume without mistaking volume
              arithmetic for a verified packing fit.
            </p>
          </div>

          <a
            href="/tools/box-utilization-calculator/"
          >
            Open calculator
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="pm-tools-card">
          <div>
            <p class="pm-tool-kicker">
              Identical-item grid
            </p>

            <h2>
              How many items fit calculator
            </h2>

            <p>
              Estimate how many identical rectangular
              items fit in one box using uniform
              axis-aligned grids and allowed rotation
              policies. A grid estimate is not a
              guaranteed maximum packing capacity.
            </p>
          </div>

          <a
            href="/tools/how-many-items-fit/"
          >
            Open calculator
            <span aria-hidden="true">→</span>
          </a>
        </article>

        <p class="pm-tools-note">
          More tools will be added only when they
          solve a real packing decision rather than
          existing as thin keyword pages.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
