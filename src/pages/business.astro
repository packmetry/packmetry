---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessWorkspace from '../components/BusinessWorkspace';
import '../styles/packmetry-workspace.css';
---

<BaseLayout
  title="Packmetry Business — Carton inventory packing"
  description="Optimize verified packing plans against your carton inventory, product quantities, weights, costs and dimensional-weight settings."
>
  <div class="pm-business-page">
    <BusinessWorkspace client:load />
  </div>
</BaseLayout>

<style>
  .pm-business-page :global(.pm-workspace) {
    width: min(
      calc(100% - 48px),
      1380px
    );
    padding-top: 34px;
  }

  .pm-business-page :global(.pm-app-header) {
    max-width: 820px;
    padding-bottom: 24px;
  }

  .pm-business-page :global(.pm-app-header h1) {
    max-width: 720px;
  }

  .pm-business-page :global(.pm-app-intro) {
    max-width: 720px;
  }

  .pm-business-page :global(.pm-workbench) {
    grid-template-columns:
      minmax(560px, 1.18fr)
      minmax(420px, 0.82fr);
    gap: 22px;
    padding-top: 22px;
  }

  .pm-business-page :global(.pm-setup-pane) {
    padding: 22px 24px 24px;
  }

  .pm-business-page :global(.pm-result-pane) {
    min-height: 430px;
    padding: 24px;
  }

  .pm-business-page :global(.pm-empty-result) {
    min-height: 375px;
  }

  .pm-business-page :global(.pm-form-section) {
    padding: 17px 0;
  }

  .pm-business-page :global(.pm-form-section-heading) {
    gap: 0;
    margin-bottom: 12px;
  }

  .pm-business-page :global(.pm-section-number) {
    display: none;
  }

  .pm-business-page
    :global(.pm-form-section-heading h3) {
    font-size: 0.96rem;
  }

  .pm-business-page
    :global(.pm-form-section-heading p) {
    max-width: 620px;
    margin-top: 3px;
    font-size: 0.75rem;
    line-height: 1.42;
  }

  .pm-business-page :global(.pm-context-note) {
    gap: 2px;
    margin: 2px 0 14px;
    padding: 7px 0 7px 10px;
    font-size: 0.74rem;
    line-height: 1.42;
  }

  .pm-business-page :global(.pm-carton-row) {
    padding: 11px 0 13px;
  }

  .pm-business-page
    :global(.pm-carton-row-header) {
    margin-bottom: 8px;
  }

  .pm-business-page
    :global(.pm-carton-fields),
  .pm-business-page
    :global(.pm-measurement-grid) {
    gap: 8px;
  }

  .pm-business-page :global(.pm-field) {
    gap: 4px;
  }

  .pm-business-page :global(.pm-field-label) {
    font-size: 0.73rem;
    line-height: 1.25;
  }

  .pm-business-page :global(.pm-number-input) {
    height: 40px;
    padding-right: 9px;
    padding-left: 9px;
    font-size: 0.86rem;
  }

  .pm-business-page :global(.pm-add-button) {
    min-height: 38px;
    padding: 7px 12px;
    border-radius: 7px;
    font-size: 0.77rem;
  }

  .pm-business-page :global(.pm-remove-button) {
    min-height: 30px;
    padding: 3px 0 3px 10px;
    font-size: 0.72rem;
  }

  .pm-business-page :global(.pm-mode-selector) {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
    gap: 2px;
  }

  .pm-business-page
    :global(
      .pm-mode-selector[aria-label^="Handling"]
    ) {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

  .pm-business-page :global(.pm-mode-option) {
    min-height: 38px;
    padding: 6px 8px;
    font-size: 0.76rem;
  }

  .pm-business-page :global(.pm-mode-explainer) {
    margin-top: 9px;
    padding-left: 10px;
  }

  .pm-business-page
    :global(.pm-mode-explainer strong) {
    font-size: 0.81rem;
  }

  .pm-business-page
    :global(.pm-mode-explainer span) {
    font-size: 0.74rem;
  }

  .pm-business-page
    :global(.pm-business-disclosure) {
    margin: 0;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary) {
    display: flex;
    min-height: 58px;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary::-webkit-details-marker) {
    display: none;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary > span:first-child) {
    display: grid;
    gap: 2px;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary strong) {
    color: var(--pm-ink-strong);
    font-size: 0.94rem;
    font-weight: 720;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary small) {
    color: var(--pm-ink-soft);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .pm-business-page
    :global(.pm-business-disclosure-state) {
    flex: none;
    border: 1px solid var(--pm-line);
    border-radius: 999px;
    padding: 3px 8px;
    background: var(--pm-surface-soft);
    color: var(--pm-ink-soft);
    font-size: 0.67rem;
    font-weight: 680;
  }

  .pm-business-page
    :global(.pm-business-disclosure-summary::after) {
    flex: 0 0 auto;
    margin-left: -8px;
    color: var(--pm-ink-soft);
    content: "+";
    font-size: 1rem;
    font-weight: 500;
  }

  .pm-business-page
    :global(.pm-business-disclosure[open] > .pm-business-disclosure-summary::after) {
    content: "−";
  }

  .pm-business-page
    :global(.pm-business-disclosure-body) {
    padding: 3px 0 2px;
  }

  .pm-business-page
    :global(.pm-business-disclosure-body > .pm-context-note:first-child) {
    margin-top: 0;
  }

  .pm-business-page
    :global(.pm-business-project-save-row) {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto;
    gap: 9px;
    align-items: end;
  }

  .pm-business-page
    :global(.pm-business-save-project-button) {
    min-width: 112px;
  }

  .pm-business-page
    :global(.pm-business-project-actions) {
    display: grid;
    grid-template-columns:
      minmax(150px, 0.7fr)
      minmax(0, 1.3fr);
    gap: 9px;
    align-items: end;
    margin-top: 10px;
  }

  .pm-business-page
    :global(.pm-business-project-actions > .pm-add-button) {
    width: 100%;
  }

  .pm-business-page
    :global(input[type="file"].pm-number-input) {
    height: 40px;
    padding: 4px;
    color: var(--pm-ink-soft);
    font-size: 0.72rem;
  }

  .pm-business-page
    :global(
      input[type="file"].pm-number-input::file-selector-button
    ) {
    height: 30px;
    margin-right: 9px;
    border: 1px solid var(--pm-line-strong);
    border-radius: 6px;
    padding: 0 9px;
    background: var(--pm-surface-soft);
    color: var(--pm-ink);
    cursor: pointer;
    font: inherit;
    font-weight: 680;
  }

  .pm-business-page
    :global(
      input[type="file"].pm-number-input::file-selector-button:hover
    ) {
    background: var(--pm-surface);
  }

  .pm-business-page :global(.pm-submit-area) {
    padding-top: 17px;
  }

  .pm-business-page :global(.pm-primary-button) {
    min-height: 46px;
    border-radius: 8px;
    font-size: 0.86rem;
  }

  .pm-business-page
    :global(
      .pm-result-pane >
      .pm-context-note:first-child
    ) {
    margin: 0 0 17px;
    padding: 0 0 15px;
    border-bottom: 1px solid var(--pm-line);
    border-left: 0;
  }

  .pm-business-page
    :global(.pm-summary-metrics) {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

  .pm-business-page
    :global(
      .pm-summary-metric:nth-child(4)
    ) {
    border-left: 0;
    padding-left: 0;
  }

  .pm-business-page
    :global(
      .pm-summary-metric:nth-child(n + 4)
    ) {
    border-top: 1px solid var(--pm-line);
  }

  .pm-business-page
    :global(.pm-summary-rationale) {
    padding: 20px 0 18px;
  }

  .pm-business-page
    :global(
      .pm-summary-rationale
      .pm-section-kicker
    ) {
    margin-bottom: 7px;
  }

  .pm-business-page
    :global(.pm-summary-rationale h3) {
    margin: 0;
    color: var(--pm-ink-strong);
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }

  .pm-business-page
    :global(
      .pm-summary-rationale >
      p:last-child
    ) {
    max-width: 620px;
    margin: 9px 0 0;
    color: var(--pm-ink-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .pm-business-page
    :global(
      section[aria-label="Packing plan actions"]
    ) {
    padding-top: 14px;
  }

  .pm-business-page
    :global(
      section[aria-label="Packing plan actions"]
      .pm-result-tabs
    ) {
    gap: 7px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .pm-business-page
    :global(
      section[aria-label="Packing plan actions"]
      .pm-result-tabs button
    ) {
    min-height: 35px;
    border: 1px solid var(--pm-line-strong);
    border-radius: 7px;
    padding: 6px 11px;
    background: var(--pm-surface);
    color: var(--pm-ink);
    font-size: 0.74rem;
  }

  .pm-business-page
    :global(
      section[aria-label="Packing plan actions"]
      .pm-result-tabs button:hover
    ) {
    border-color: #aebbc7;
    background: var(--pm-surface-soft);
  }

  .pm-business-page
    :global(.pm-summary-details) {
    margin-top: 13px;
  }

  .pm-business-page
    :global(.pm-plan-output > .pm-viz) {
    margin-top: 21px;
    padding-top: 20px;
  }

  .pm-business-page :global(.pm-viz-header) {
    margin-bottom: 13px;
  }

  .pm-business-page :global(.pm-viz-caption) {
    margin-top: 9px;
  }

  @media (max-width: 1099px) {
    .pm-business-page :global(.pm-workspace) {
      width: min(
        calc(100% - 40px),
        940px
      );
    }

    .pm-business-page :global(.pm-workbench) {
      grid-template-columns: 1fr;
    }

    .pm-business-page :global(.pm-result-pane) {
      min-height: 400px;
    }

    .pm-business-page :global(.pm-empty-result) {
      min-height: 340px;
    }
  }

  @media (max-width: 639px) {
    .pm-business-page :global(.pm-workspace) {
      width: calc(100% - 32px);
      padding-top: 20px;
    }

    .pm-business-page :global(.pm-app-header) {
      padding-bottom: 18px;
    }

    .pm-business-page :global(.pm-workbench) {
      gap: 16px;
      padding-top: 16px;
    }

    .pm-business-page :global(.pm-setup-pane),
    .pm-business-page :global(.pm-result-pane) {
      padding: 16px;
    }

    .pm-business-page :global(.pm-form-section) {
      padding: 14px 0;
    }

    .pm-business-page
      :global(.pm-carton-fields),
    .pm-business-page
      :global(.pm-measurement-grid) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
      gap: 8px;
    }

    .pm-business-page
      :global(.pm-business-project-save-row),
    .pm-business-page
      :global(.pm-business-project-actions) {
      grid-template-columns: 1fr;
    }

    .pm-business-page
      :global(
        .pm-mode-selector[aria-label^="Handling"]
      ) {
      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        );
    }

    .pm-business-page :global(.pm-mode-selector) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .pm-business-page :global(.pm-mode-option) {
      min-height: 43px;
      padding: 6px 5px;
      font-size: 0.68rem;
      text-align: center;
    }

    .pm-business-page :global(.pm-field-label) {
      font-size: 0.68rem;
    }

    .pm-business-page :global(.pm-number-input) {
      height: 40px;
    }

    .pm-business-page :global(.pm-add-button) {
      min-height: 36px;
    }

    .pm-business-page
      :global(.pm-business-disclosure-summary) {
      min-height: 54px;
      align-items: center;
      gap: 8px 12px;
      padding: 4px 0;
    }

    .pm-business-page
      :global(.pm-business-disclosure-state) {
      margin-left: auto;
    }

    .pm-business-page
      :global(.pm-business-save-project-button) {
      width: 100%;
    }

    .pm-business-page :global(.pm-result-pane) {
      min-height: 330px;
    }

    .pm-business-page :global(.pm-empty-result) {
      min-height: 290px;
    }

    .pm-business-page :global(.pm-summary-header) {
      display: grid;
      grid-template-columns:
        1fr auto;
      gap: 10px;
      align-items: start;
    }

    .pm-business-page :global(.pm-summary-status) {
      width: fit-content;
      justify-self: end;
    }

    .pm-business-page
      :global(.pm-summary-metrics) {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .pm-business-page
      :global(.pm-summary-metric:nth-child(4)) {
      border-left: 1px solid var(--pm-line);
      padding-left: 14px;
    }

    .pm-business-page
      :global(.pm-summary-metric:nth-child(odd)) {
      border-left: 0;
      padding-left: 0;
    }

    .pm-business-page
      :global(.pm-summary-metric:nth-child(n + 3)) {
      border-top: 1px solid var(--pm-line);
    }

    .pm-business-page :global(.pm-viz-canvas) {
      min-height: 270px;
    }
  }

  @media (max-width: 359px) {
    .pm-business-page
      :global(.pm-carton-fields),
    .pm-business-page
      :global(.pm-measurement-grid),
    .pm-business-page :global(.pm-mode-selector),
    .pm-business-page
      :global(
        .pm-mode-selector[aria-label^="Handling"]
      ) {
      grid-template-columns: 1fr;
    }

    .pm-business-page :global(.pm-mode-option) {
      text-align: left;
    }
  }
</style>
