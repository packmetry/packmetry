---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackingWorkspace from '../components/PackingWorkspace';
---

<BaseLayout>
  <PackingWorkspace client:load />
</BaseLayout>

<style is:global>
  html {
    background: #f7f7f8;
  }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: #f7f7f8;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>