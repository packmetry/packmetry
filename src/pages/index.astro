</style>

<script is:inline>
  (() => {
    const region =
      document.querySelector(
        '.pm-home-geometry'
      );

    const drawing =
      document.querySelector(
        '.pm-home-geometry-drawing'
      );

    const itemA =
      document.querySelector(
        '.pm-home-item-a'
      );

    const itemB =
      document.querySelector(
        '.pm-home-item-b'
      );

    const itemC =
      document.querySelector(
        '.pm-home-item-c'
      );

    if (
      !(region instanceof HTMLElement) ||
      !(drawing instanceof SVGElement)
    ) {
      return;
    }

    let frame = 0;

    const setTransforms = (
      x,
      y
    ) => {
      drawing.style.transform =
        `perspective(820px) rotateX(${
          (-y * 10).toFixed(2)
        }deg) rotateY(${
          (x * 12).toFixed(2)
        }deg) translate3d(${
          (x * 7).toFixed(2)
        }px, ${
          (y * 5).toFixed(2)
        }px, 0)`;

      if (itemA instanceof SVGElement) {
        itemA.style.transform =
          `translate(${
            (x * -8).toFixed(2)
          }px, ${
            (y * -4).toFixed(2)
          }px)`;
      }

      if (itemB instanceof SVGElement) {
        itemB.style.transform =
          `translate(${
            (x * 9).toFixed(2)
          }px, ${
            (y * 3).toFixed(2)
          }px)`;
      }

      if (itemC instanceof SVGElement) {
        itemC.style.transform =
          `translate(${
            (x * -3).toFixed(2)
          }px, ${
            (y * 5).toFixed(2)
          }px)`;
      }
    };

    const reset = () => {
      cancelAnimationFrame(frame);

      drawing.style.transform =
        'perspective(820px) rotateX(0deg) rotateY(0deg) translate3d(0, 0, 0)';

      if (itemA instanceof SVGElement) {
        itemA.style.transform =
          'translate(0, 0)';
      }

      if (itemB instanceof SVGElement) {
        itemB.style.transform =
          'translate(0, 0)';
      }

      if (itemC instanceof SVGElement) {
        itemC.style.transform =
          'translate(0, 0)';
      }
    };

    region.addEventListener(
      'mousemove',
      event => {
        const rect =
          region.getBoundingClientRect();

        const x =
          Math.max(
            -0.5,
            Math.min(
              0.5,
              (event.clientX - rect.left) /
                rect.width -
                0.5
            )
          );

        const y =
          Math.max(
            -0.5,
            Math.min(
              0.5,
              (event.clientY - rect.top) /
                rect.height -
                0.5
            )
          );

        cancelAnimationFrame(frame);

        frame = requestAnimationFrame(
          () => setTransforms(x, y)
        );
      }
    );

    region.addEventListener(
      'mouseleave',
      reset
    );

    window.addEventListener(
      'blur',
      reset
    );
  })();
</script>
