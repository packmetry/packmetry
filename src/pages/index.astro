---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/packmetry-workspace.css';
---

<BaseLayout
  title="Packmetry — Practical packing decisions"
  description="Find practical, verified packing plans for personal shipments and business carton workflows."
>
  <main class="pm-home">
    <section class="pm-home-hero">
      <div class="pm-home-hero-inner">
        <div class="pm-home-copy">
          <p class="pm-home-eyebrow">
            Browser-first packing workbench
          </p>

          <h1>
            Find the right way
            <span>to pack it.</span>
          </h1>

          <p class="pm-home-lead">
            Work out which boxes to use,
            how your items fit, and how much
            space the plan leaves behind —
            without turning packing into a
            spreadsheet exercise.
          </p>

          <div class="pm-home-actions">
            <a
              class="pm-home-primary-action"
              href="/personal/"
            >
              Pack my items

              <svg
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>

            <a
              class="pm-home-secondary-action"
              href="/business/"
            >
              Business workspace
            </a>
          </div>

          <p class="pm-home-trust">
            Free
            <span aria-hidden="true">·</span>
            No signup required
            <span aria-hidden="true">·</span>
            Runs in your browser
          </p>
        </div>

        <div
          class="pm-home-geometry"
          aria-hidden="true"
        >
          <div class="pm-home-geometry-caption">
            <span>
              <strong>Arrangement</strong>
              <span>3D</span>
            </span>

            <span>
              <strong>Verified</strong>
              <span>Packing geometry</span>
            </span>
          </div>

          <div class="pm-home-geometry-scene">
            <svg
              class="pm-home-geometry-drawing"
              viewBox="0 0 620 430"
            >
              <defs>
                <filter
                  id="pm-home-item-shadow"
                  x="-30%"
                  y="-30%"
                  width="160%"
                  height="180%"
                >
                  <feDropShadow
                    dx="0"
                    dy="9"
                    stdDeviation="8"
                    flood-color="#17212b"
                    flood-opacity="0.08"
                  />
                </filter>
              </defs>

              <g class="pm-home-box-outline">
                <path d="M108 111 310 49 512 111 310 177 108 111Z" />
                <path d="M108 111v211l202 66 202-66V111" />
                <path d="M310 177v211" />
              </g>

              <g
                class="pm-home-item pm-home-item-a"
                filter="url(#pm-home-item-shadow)"
              >
                <path d="M138 236 226 208l86 28-88 29-86-29Z" />
                <path d="M138 236v74l86 28 88-28v-74" />
                <path d="M224 265v73" />
              </g>

              <g
                class="pm-home-item pm-home-item-b"
                filter="url(#pm-home-item-shadow)"
              >
                <path d="M320 235 404 209l74 24-84 27-74-25Z" />
                <path d="M320 235v91l74 25 84-28v-90" />
                <path d="M394 260v91" />
              </g>

              <g class="pm-home-item pm-home-item-c">
                <path d="M177 169 276 138l81 26-99 32-81-27Z" />
                <path d="M177 169v57l81 27 99-32v-57" />
                <path d="M258 196v57" />
              </g>

              <g class="pm-home-dimension-lines">
                <path d="M88 111v211" />
                <path d="M76 111h24M76 322h24" />

                <path d="M108 345 310 412" />
                <path d="M108 333v24M310 400v24" />
              </g>
            </svg>
          </div>

          <div class="pm-home-geometry-meta">
            <div>
              <span>Placement</span>
              <strong>Verified</strong>
            </div>

            <div>
              <span>View</span>
              <strong>Canonical plan</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="pm-home-choice"
      aria-label="Choose your packing experience"
    >
      <div class="pm-home-section-heading pm-home-choice-heading">
        <p class="pm-home-section-eyebrow">
          Choose your packing experience
        </p>

        <h2>
          <span>One packing engine.</span>
          <span>Two ways to work.</span>
        </h2>
      </div>

      <div class="pm-home-choice-surface">
        <article class="pm-home-path">
          <div class="pm-home-path-top">
            <span class="pm-home-path-label">
              Home &amp; Personal
            </span>

            <svg
              class="pm-home-path-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="m4 10 8-6 8 6v9H4v-9Z" />
              <path d="M9 19v-6h6v6" />
            </svg>
          </div>

          <h3>
            Pack everyday items without
            overthinking the box.
          </h3>

          <p>
            Moving, storage, gifts and
            occasional shipping. Add what
            you are packing and work from
            the boxes you have — or find
            what size you need.
          </p>

          <div class="pm-home-path-facts">
            <span>Multiple items</span>
            <span>Metric or imperial</span>
            <span>3D packing view</span>
          </div>

          <a href="/personal/">
            Pack my items

            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </article>

        <article class="pm-home-path">
          <div class="pm-home-path-top">
            <span class="pm-home-path-label">
              Business
            </span>

            <svg
              class="pm-home-path-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="m4 7 8-4 8 4v10l-8 4-8-4V7Z" />
              <path d="m4 7 8 4 8-4M12 11v10" />
            </svg>
          </div>

          <h3>
            Make repeat packing decisions
            against real carton inventory.
          </h3>

          <p>
            Work with product quantities,
            carton stock, handling rules,
            optional weights, costs and
            dimensional-weight inputs in
            one verified workflow.
          </p>

          <div class="pm-home-path-facts">
            <span>Carton inventory</span>
            <span>Objective ranking</span>
            <span>DIM analysis</span>
          </div>

          <a href="/business/">
            Optimize my packing

            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </article>
      </div>
    </section>

    <section class="pm-home-system">
      <div class="pm-home-section-heading pm-home-system-heading">
        <p class="pm-home-section-eyebrow">
          Built around the packing decision
        </p>

        <h2>
          Start with the boxes you actually
          have — or do not have.
        </h2>
      </div>

      <div class="pm-home-system-copy">
        <div class="pm-home-mode-line">
          <span>Need boxes</span>
          <span aria-hidden="true">/</span>
          <span>Have boxes</span>
          <span aria-hidden="true">/</span>
          <span>Hybrid</span>
        </div>

        <p>
          Packmetry handles the three situations
          that matter in practice:
          <strong>find boxes to buy</strong>,
          <strong>pack into existing boxes</strong>,
          or
          <strong>use existing stock and cover the remainder</strong>.
        </p>

        <div class="pm-home-verification-flow">
          <span>Solver candidate</span>
          <span
            class="pm-home-flow-arrow"
            aria-hidden="true"
          >
            →
          </span>
          <span>Independent verification</span>
          <span
            class="pm-home-flow-arrow"
            aria-hidden="true"
          >
            →
          </span>
          <span>Canonical plan</span>
        </div>

        <p class="pm-home-system-note">
          Solver candidates are independently
          verified before a successful packing
          result is presented. The 3D view follows
          that verified plan instead of inventing
          a separate arrangement.
        </p>
      </div>
    </section>

    <section class="pm-home-close">
      <div>
        <p class="pm-home-section-eyebrow">
          Practical by design
        </p>

        <h2>
          Your measurements stay useful
          without needing an account.
        </h2>
      </div>

      <div class="pm-home-close-copy">
        <p>
          Personal preferences, recent packing
          work and Business project data can stay
          browser-local. Start with the tool you
          need and keep the workflow as simple as
          the job allows.
        </p>

        <div class="pm-home-close-actions">
          <a
            class="pm-home-primary-action pm-home-close-button"
            href="/personal/"
          >
            Personal workspace

            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>

          <a
            class="pm-home-close-button pm-home-close-button-secondary"
            href="/business/"
          >
            Business workspace

            <svg
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pm-home {
    background: #fbfcfb;
    color: var(--pm-ink);
  }

  .pm-home-hero {
    border-bottom: 1px solid var(--pm-line);
    background:
      linear-gradient(
        180deg,
        #fbfcfb 0%,
        #fbfcfb 77%,
        #f9fbfa 100%
      );
  }

  .pm-home-hero-inner {
    display: grid;
    width: min(
      calc(100% - 40px),
      1240px
    );
    min-height: 605px;
    margin: 0 auto;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(420px, 0.9fr);
    gap: clamp(56px, 8vw, 116px);
    align-items: center;
    padding: 82px 0 88px;
  }

  .pm-home-copy {
    max-width: 620px;
  }

  .pm-home-eyebrow,
  .pm-home-section-eyebrow {
    margin: 0;
    color: var(--pm-forest);
    font-size: 0.71rem;
    font-weight: 730;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pm-home-copy > .pm-home-eyebrow {
    margin-bottom: 19px;
  }

  .pm-home-copy h1 {
    margin: 0;
    color: var(--pm-ink-strong);
    font-size:
      clamp(
        3.15rem,
        6vw,
        5.75rem
      );
    font-weight: 690;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .pm-home-copy h1 span {
    display: block;
    color: #4f5b5f;
    font-weight: 560;
  }

  .pm-home-lead {
    max-width: 570px;
    margin: 26px 0 0;
    color: var(--pm-ink-soft);
    font-size: clamp(
      1rem,
      1.5vw,
      1.18rem
    );
    line-height: 1.65;
  }

  .pm-home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: 31px;
  }

  .pm-home-primary-action {
    display: inline-flex;
    min-height: 46px;
    gap: 11px;
    align-items: center;
    border: 1px solid var(--pm-navy);
    border-radius: 8px;
    padding: 10px 17px;
    background: var(--pm-navy);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 710;
    text-decoration: none;
    transition:
      background 140ms ease,
      border-color 140ms ease,
      transform 140ms ease;
  }

  .pm-home-primary-action:hover {
    border-color: #10283d;
    background: #10283d;
    transform: translateY(-1px);
  }

  .pm-home-primary-action svg,
  .pm-home-path a svg,
  .pm-home-close-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }

  .pm-home-secondary-action {
    color: var(--pm-ink);
    font-size: 0.86rem;
    font-weight: 680;
    text-decoration-color:
      var(--pm-line-strong);
    text-underline-offset: 5px;
  }

  .pm-home-secondary-action:hover {
    color: var(--pm-navy);
    text-decoration-color:
      var(--pm-navy);
  }

  .pm-home-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 25px 0 0;
    color: #798184;
    font-size: 0.73rem;
    font-weight: 590;
  }

  .pm-home-trust span {
    color: #b0b7b9;
  }

  /* hero geometry */

  .pm-home-geometry {
    position: relative;
    align-self: stretch;
    display: flex;
    min-height: 440px;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid var(--pm-line);
    padding-left: clamp(
      35px,
      5vw,
      72px
    );
  }

  .pm-home-geometry::before {
    position: absolute;
    top: 50%;
    left: 58%;
    width: 310px;
    height: 310px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(46, 93, 80, 0.055) 0%,
        rgba(46, 93, 80, 0.018) 42%,
        transparent 70%
      );
    content: "";
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .pm-home-geometry-caption {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 4px;
  }

  .pm-home-geometry-caption > span {
    display: grid;
    gap: 2px;
  }

  .pm-home-geometry-caption > span:last-child {
    text-align: left;
  }

  .pm-home-geometry-caption strong {
    color: var(--pm-ink);
    font-size: 0.78rem;
    font-weight: 680;
    line-height: 1.2;
  }

  .pm-home-geometry-caption > span > span {
    color: #818a8d;
    font-size: 0.67rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .pm-home-geometry-scene {
    position: relative;
    z-index: 1;
  }

  .pm-home-geometry-scene::after {
    position: absolute;
    right: 7%;
    bottom: 8%;
    left: 7%;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        #d7dddf 18%,
        #d7dddf 82%,
        transparent
      );
    content: "";
  }

  .pm-home-geometry-drawing {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    max-width: 560px;
    overflow: visible;
    filter:
      drop-shadow(
        0 16px 20px
        rgba(23, 33, 43, 0.025)
      );
    transform:
      perspective(820px)
      rotateX(0deg)
      rotateY(0deg)
      translate3d(0, 0, 0);
    transform-origin: 50% 52%;
    transition:
      transform 150ms
      cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  .pm-home-box-outline {
    fill: rgba(
      255,
      255,
      255,
      0.18
    );
    stroke: #526064;
    stroke-width: 1.25;
  }

  .pm-home-item {
    transform-box: fill-box;
    transform-origin: center;
    stroke-linejoin: round;
    stroke-width: 1.1;
    transition:
      transform 170ms
      cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  .pm-home-item-a {
    fill: rgba(
      46,
      93,
      80,
      0.095
    );
    stroke: #497468;
  }

  .pm-home-item-b {
    fill: rgba(
      24,
      50,
      74,
      0.085
    );
    stroke: #506a80;
  }

  .pm-home-item-c {
    fill: rgba(
      107,
      119,
      121,
      0.055
    );
    stroke: #7b888b;
  }

  .pm-home-dimension-lines {
    fill: none;
    stroke: #bcc4c6;
    stroke-width: 0.9;
  }

  .pm-home-geometry-meta {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
    margin-top: 3px;
    border-top: 1px solid var(--pm-line);
  }

  .pm-home-geometry-meta div {
    display: grid;
    gap: 3px;
    padding: 13px 0 0;
  }

  .pm-home-geometry-meta div + div {
    border-left: 1px solid var(--pm-line);
    padding-left: 18px;
  }

  .pm-home-geometry-meta span {
    color: #818a8d;
    font-size: 0.67rem;
  }

  .pm-home-geometry-meta strong {
    color: var(--pm-ink);
    font-size: 0.78rem;
    font-weight: 680;
  }

  /* consistent section headings */

  .pm-home-section-heading {
    display: block !important;
    width: 100%;
    max-width: 690px;
    grid-template-columns: none !important;
  }

  .pm-home-section-heading
    .pm-home-section-eyebrow {
    display: block;
    width: 100%;
    margin: 0 0 13px;
  }

  .pm-home-choice-heading,
  .pm-home-system-heading {
    display: block !important;
    grid-template-columns: none !important;
  }

  .pm-home-section-heading h2,
  .pm-home-close h2 {
    margin: 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      1.8rem,
      3vw,
      2.75rem
    );
    font-weight: 630;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  /* experience choice */

  .pm-home-choice {
    width: min(
      calc(100% - 40px),
      1240px
    );
    margin: 0 auto;
    padding: 92px 0 96px;
  }

  .pm-home-choice-heading {
    margin-bottom: 36px;
  }

  .pm-home-choice-heading h2 span {
    display: block;
  }

  .pm-home-choice-surface {
    display: grid;
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
    overflow: hidden;
    border: 1px solid var(--pm-line-strong);
    border-radius: 14px;
    background: var(--pm-surface);
    box-shadow:
      0 1px 2px rgba(23, 33, 43, 0.02);
  }

  .pm-home-path {
    position: relative;
    display: flex;
    min-height: 430px;
    flex-direction: column;
    padding:
      clamp(30px, 4vw, 48px);
    transition:
      background 150ms ease;
  }

  .pm-home-path:hover {
    background: #fcfdfc;
  }

  .pm-home-path + .pm-home-path {
    border-left: 1px solid var(--pm-line);
  }

  .pm-home-path-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
  }

  .pm-home-path-label {
    color: var(--pm-forest);
    font-size: 0.74rem;
    font-weight: 730;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .pm-home-path-icon {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: #758185;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    transition:
      stroke 150ms ease,
      transform 150ms ease;
  }

  .pm-home-path:hover
    .pm-home-path-icon {
    stroke: var(--pm-forest);
    transform: translateY(-1px);
  }

  .pm-home-path h3 {
    max-width: 500px;
    margin: 50px 0 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      1.55rem,
      2.3vw,
      2.15rem
    );
    font-weight: 620;
    letter-spacing: -0.037em;
    line-height: 1.1;
  }

  .pm-home-path > p {
    max-width: 510px;
    margin: 17px 0 0;
    color: var(--pm-ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .pm-home-path-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 17px;
    margin-top: 25px;
    color: #697376;
    font-size: 0.72rem;
    font-weight: 620;
  }

  .pm-home-path-facts span {
    position: relative;
  }

  .pm-home-path-facts span +
  span::before {
    margin-right: 17px;
    color: #c2c8ca;
    content: "·";
  }

  .pm-home-path a {
    display: inline-flex;
    width: fit-content;
    gap: 10px;
    align-items: center;
    margin-top: auto;
    padding-top: 37px;
    color: var(--pm-navy);
    font-size: 0.86rem;
    font-weight: 720;
    text-decoration: none;
  }

  .pm-home-path a:hover {
    color: var(--pm-forest);
  }

  /* packing decision section */

  .pm-home-system {
    display: grid;
    width: min(
      calc(100% - 40px),
      1240px
    );
    margin: 0 auto;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: clamp(
      50px,
      8vw,
      110px
    );
    padding: 91px 0 94px;
    border-top: 1px solid var(--pm-line);
  }

  .pm-home-system-heading {
    max-width: 500px;
  }

  .pm-home-system-copy {
    display: grid;
    align-content: center;
  }

  .pm-home-mode-line {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 10px;
    align-items: center;
    margin-bottom: 18px;
    color: var(--pm-forest);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .pm-home-mode-line
    span[aria-hidden="true"] {
    color: #bdc6c3;
    font-weight: 500;
  }

  .pm-home-system-copy > p {
    margin: 0;
    color: var(--pm-ink-soft);
    font-size: 0.91rem;
    line-height: 1.7;
  }

  .pm-home-system-copy strong {
    color: var(--pm-ink);
    font-weight: 680;
  }

  .pm-home-verification-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 24px 0 18px;
    padding: 11px 0;
    border-top: 1px solid var(--pm-line);
    border-bottom: 1px solid var(--pm-line);
    color: #657174;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .pm-home-flow-arrow {
    color: #9ba6a9;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1;
  }

  .pm-home-system-copy
    .pm-home-system-note {
