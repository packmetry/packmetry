---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main>
    <h1>Packmetry</h1>
    <p>Universal browser-based packing decision workbench</p>
    <p>This is a minimal placeholder page proving Astro runs.</p>
    <p><em>Production codebase foundation established.</em></p>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  
  h1 {
    margin-bottom: 1rem;
    color: #1a1a1a;
  }
  
  p {
    margin-bottom: 0.5rem;
    color: #333;
  }
</style>