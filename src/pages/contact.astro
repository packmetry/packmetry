---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/packmetry-workspace.css';
---

<BaseLayout
  title="Contact Packmetry — Product questions, feedback and support"
  description="Contact Packmetry by email for product questions, feedback, bug reports, business inquiries and other packing-workbench questions."
>
  <main class="pm-contact">
    <header class="pm-contact-hero">
      <p class="pm-contact-eyebrow">
        Contact Packmetry
      </p>

      <h1>
        A direct line for
        <span>useful conversations.</span>
      </h1>

      <p>
        Questions about the product, feedback on a
        workflow, a bug you found, or a business
        inquiry — email is the simplest way to
        reach Packmetry right now.
      </p>
    </header>

    <section
      class="pm-contact-main"
      aria-labelledby="contact-email-title"
    >
      <div class="pm-contact-email">
        <p class="pm-contact-eyebrow">
          Email
        </p>

        <h2 id="contact-email-title">
          packmetry@gmail.com
        </h2>

        <p>
          Include enough context for the message to
          be useful: what you were trying to do,
          what happened, and any relevant packing
          details.
        </p>

        <a
          class="pm-contact-button"
          href="mailto:packmetry@gmail.com"
        >
          Email Packmetry
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="pm-contact-topics">
        <article>
          <span>01</span>

          <div>
            <h3>Product questions</h3>

            <p>
              Ask about Personal or Business
              workflows, box availability modes,
              dimensional weight, or how a result
              should be interpreted.
            </p>
          </div>
        </article>

        <article>
          <span>02</span>

          <div>
            <h3>Feedback &amp; bug reports</h3>

            <p>
              Share something that feels confusing,
              incorrect, difficult to use, or worth
              improving.
            </p>
          </div>
        </article>

        <article>
          <span>03</span>

          <div>
            <h3>Business inquiries</h3>

            <p>
              Reach out about larger packing
              workflows, future integrations,
              collaboration, or product use in an
              operational setting.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="pm-contact-note">
      <div>
        <p class="pm-contact-eyebrow">
          Helpful context
        </p>

        <h2>
          A good message makes the next step easier.
        </h2>
      </div>

      <p>
        For a packing issue, include item and carton
        dimensions, the workflow you used, and what
        you expected to happen. Do not send passwords,
        payment details, or other sensitive account
        information.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .pm-contact {
    width: min(
      calc(100% - 40px),
      1240px
    );
    margin: 0 auto;
    padding: 82px 0 82px;
  }

  .pm-contact-hero {
    max-width: 880px;
    padding-bottom: 72px;
  }

  .pm-contact-eyebrow {
    margin: 0;
    color: var(--pm-forest);
    font-size: 0.71rem;
    font-weight: 740;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pm-contact-hero h1 {
    margin: 18px 0 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      3.2rem,
      6vw,
      5.8rem
    );
    font-weight: 680;
    letter-spacing: -0.062em;
    line-height: 0.94;
  }

  .pm-contact-hero h1 span {
    display: block;
    color: #556165;
    font-weight: 560;
  }

  .pm-contact-hero > p:last-child {
    max-width: 710px;
    margin: 27px 0 0;
    color: var(--pm-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  .pm-contact-main {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    border-top: 1px solid var(--pm-line);
    border-bottom: 1px solid var(--pm-line);
  }

  .pm-contact-email {
    display: flex;
    min-height: 430px;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--pm-line);
    padding: 54px 58px 54px 0;
  }

  .pm-contact-email h2 {
    margin: 16px 0 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      1.8rem,
      3vw,
      2.8rem
    );
    font-weight: 650;
    letter-spacing: -0.042em;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .pm-contact-email > p:not(.pm-contact-eyebrow) {
    max-width: 520px;
    margin: 20px 0 0;
    color: var(--pm-ink-soft);
    font-size: 0.9rem;
    line-height: 1.67;
  }

  .pm-contact-button {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    gap: 12px;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    border: 1px solid var(--pm-navy);
    border-radius: 8px;
    padding: 10px 15px;
    background: var(--pm-navy);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 720;
    text-decoration: none;
    transition:
      transform 140ms ease,
      background 140ms ease;
  }

  .pm-contact-button:hover {
    background: #203f58;
    transform: translateY(-1px);
  }

  .pm-contact-topics {
    display: grid;
    padding-left: 54px;
  }

  .pm-contact-topics article {
    display: grid;
    grid-template-columns:
      40px
      minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    border-bottom: 1px solid var(--pm-line);
    padding: 38px 0;
  }

  .pm-contact-topics article:last-child {
    border-bottom: 0;
  }

  .pm-contact-topics article > span {
    color: #99a2a5;
    font-size: 0.69rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pm-contact-topics h3 {
    margin: 0;
    color: var(--pm-ink-strong);
    font-size: 1.12rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.22;
  }

  .pm-contact-topics p {
    max-width: 560px;
    margin: 10px 0 0;
    color: var(--pm-ink-soft);
    font-size: 0.86rem;
    line-height: 1.62;
  }

  .pm-contact-note {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.72fr);
    gap: clamp(
      45px,
      8vw,
      100px
    );
    align-items: end;
    margin-top: 76px;
    border: 1px solid #dbe2df;
    border-radius: 14px;
    padding:
      clamp(30px, 5vw, 56px);
    background:
      linear-gradient(
        135deg,
        #f3f7f5 0%,
        #f7f9f8 100%
      );
  }

  .pm-contact-note h2 {
    margin: 12px 0 0;
    color: var(--pm-ink-strong);
    font-size: clamp(
      1.9rem,
      3.4vw,
      3rem
    );
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .pm-contact-note > p {
    margin: 0;
    color: var(--pm-ink-soft);
    font-size: 0.87rem;
    line-height: 1.68;
  }

  @media (max-width: 760px) {
    .pm-contact {
      width: calc(100% - 32px);
      padding: 48px 0 54px;
    }

    .pm-contact-hero {
      padding-bottom: 50px;
    }

    .pm-contact-hero h1 {
      font-size: clamp(
        2.8rem,
        14vw,
        4rem
      );
    }

    .pm-contact-main {
      grid-template-columns: 1fr;
    }

    .pm-contact-email {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--pm-line);
      padding: 38px 0;
    }

    .pm-contact-topics {
      padding-left: 0;
    }

    .pm-contact-topics article {
      grid-template-columns:
        34px
        minmax(0, 1fr);
      gap: 14px;
      padding: 28px 0;
    }

    .pm-contact-note {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 54px;
      padding: 26px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-contact-button {
      transition: none;
    }
  }
</style>
